# Set these as environment variables before starting; this file is a reference.
VAULT_HOST=127.0.0.1
VAULT_PORT=8765
VAULT_QUOTA_MB=500
VAULT_COOKIE_SECURE=0
# VAULT_DATA_DIR=D:/ImageVaultData
# Login-page cover images. Defaults to the project's image folder.
# VAULT_COVERS_DIR=D:/MyTools/爬取百度图片/image
# Set a private Pixabay API key on the backend only.
# Set PIXABAY_API_KEY in your environment before enabling Pixabay search.
# VAULT_BAIDU_BROWSER=1
# VAULT_BROWSER_CHANNEL=chrome
